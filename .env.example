# Public environment variables for Minkup frontend.
# Copy to .env.local and fill in values before running the app.

# Contact integration — Google Forms entry endpoint for enquiries.
VITE_GOOGLE_FORMS_ENDPOINT=
VITE_GOOGLE_FORMS_ENTRY_NAME=
VITE_GOOGLE_FORMS_ENTRY_EMAIL=
VITE_GOOGLE_FORMS_ENTRY_PHONE=
VITE_GOOGLE_FORMS_ENTRY_BUSINESS=
VITE_GOOGLE_FORMS_ENTRY_SERVICE=
VITE_GOOGLE_FORMS_ENTRY_MESSAGE=
VITE_GOOGLE_FORMS_ENTRY_BUDGET=

# WhatsApp number for the floating CTA. International format, digits only.
VITE_WHATSAPP_NUMBER=

# Optional backend base URL for enquiry submissions when running a server.
VITE_API_BASE_URL=
